# =====================================================================
# SmartCampus — configuration de développement (deux microservices réels)
# =====================================================================

# Service académique (Spring Boot) : http://localhost:8081, préfixe /api
VITE_API_BASE_URL=http://localhost:8081/api

# user-service (Node/Express, module Utilisateurs) : http://localhost:4001
# Routes exposées sans /api (/auth/login, /users, /roles...).
# Si une API Gateway unique route /api vers les deux services, mettez la même
# valeur que VITE_API_BASE_URL ci-dessus.
VITE_USER_API_BASE_URL=http://localhost:4001

# Résidences (NestJS : Chambre, Demande, Contrat) : http://localhost:3001, préfixe /api
# (dossier backend-residences/ — npm run start:dev)
VITE_RESIDENCES_API_BASE_URL=http://localhost:3001/api

# false = les routes listées ci-dessous sont servies par les vrais services
VITE_USE_MOCKS=false

# Domaine d'e-mail accepté à l'inscription. Doit correspondre à EMAIL_DOMAIN
# du user-service (gmail.com par défaut dans le dépôt back-end).
VITE_EMAIL_DOMAIN=gmail.com

# Routes servies par de vrais microservices quand VITE_USE_MOCKS=false
# (les autres modules restent en données fictives).
#   /academic                          -> service académique (VITE_API_BASE_URL)
#   /auth,/users,/roles,/login-history -> user-service (VITE_USER_API_BASE_URL)
#   /chambres,/demandes,/contrats      -> résidences (VITE_RESIDENCES_API_BASE_URL)
# Attention : ne listez que des routes réellement servies, sinon le module casse.
VITE_REAL_API_PREFIXES=/academic,/auth,/users,/roles,/login-history,/chambres,/demandes,/contrats
