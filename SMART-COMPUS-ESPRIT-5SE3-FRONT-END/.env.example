# =====================================================================
# SmartCampus - Configuration environnement de developpement
# =====================================================================

# Service academique (Spring Boot) : port 8081, prefixe /api
VITE_API_BASE_URL=http://localhost:8081/api

# Service Utilisateurs & Auth (Node.js Express) : port 4001
VITE_USER_API_BASE_URL=http://localhost:4001

# Service Residences (NestJS) : port 3001, prefixe /api
VITE_RESIDENCES_API_BASE_URL=http://localhost:3001/api

# Service Vie Etudiante (Spring Boot) : port 4005
VITE_STUDENT_LIFE_API_BASE_URL=http://localhost:4005

# Service Bibliotheque (Python FastAPI) : port 8082
VITE_LIBRARY_API_BASE_URL=http://localhost:8082

# false = requetes transmises aux vrais microservices
VITE_USE_MOCKS=false

# Domaine e-mail institutionnel
VITE_EMAIL_DOMAIN=gmail.com

# Routes servies par les microservices reels quand VITE_USE_MOCKS=false
VITE_REAL_API_PREFIXES=/academic,/auth,/users,/roles,/login-history,/chambres,/demandes,/contrats,/clubs,/memberships,/events,/books,/loans,/reservations
