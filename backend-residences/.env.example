# =====================================================================
# SmartCampus - Residences (microservices) : configuration exemple
# Un seul .env a la racine de backend-residences/ pilote les 4 applications.
# Copiez ce fichier en .env et adaptez les valeurs.
# =====================================================================

NODE_ENV=development

# Passerelle API (JWT + proxy vers les microservices)
GATEWAY_PORT=3001
JWT_SECRET=change-me-in-production
JWT_ISSUER=SmartCampus
# Accepte le jeton de demonstration non signe du front (mode dev uniquement ;
# doit valoir false des que l'authentification reelle est branchee en prod)
AUTH_ACCEPT_DEMO_TOKEN=true

# Adresses internes des microservices (la passerelle y proxifie /api/*)
CHAMBRES_PORT=3011
DEMANDES_PORT=3012
CONTRATS_PORT=3013
CHAMBRES_URL=http://localhost:3011
DEMANDES_URL=http://localhost:3012
CONTRATS_URL=http://localhost:3013

# PostgreSQL : une instance, un schema par service (database-per-service)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smartcampus
DB_CHAMBRES_SCHEMA=BDD_Chambres
DB_DEMANDES_SCHEMA=BDD_Demandes
DB_CONTRATS_SCHEMA=BDD_Contrats
DB_SYNCHRONIZE=true
DB_LOGGING=false

# RabbitMQ (bus d'evenements Demande -> Contrat, file durable)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=residences.contrats.events
