# Configuration du microservice Gestion de la Bibliothèque
PORT=8082
HOST=0.0.0.0
ENV=development

# Base de données
DATABASE_URL=sqlite:///./library.db

# Authentification JWT (partagé avec le user-service)
JWT_SECRET=change-me-en-production-32-caracteres-minimum
JWT_ALGORITHM=HS256
JWT_ISSUER=smartcampus-user-service
JWT_AUDIENCE=smartcampus

# Intégrations Microservices
USER_SERVICE_URL=http://localhost:4001
FINANCIAL_SERVICE_URL=http://localhost:8083

# Service Discovery (Eureka - Spring Cloud / Netflix OSS)
EUREKA_SERVER=http://localhost:8761/eureka
EUREKA_ENABLED=false
APP_NAME=LIBRARY-SERVICE

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ENABLED=false
RABBITMQ_EXCHANGE=smartcampus.events

# Configuration SMTP (Notifications d'emprunt et retards)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SmartCampus Bibliothèque <bibliotheque@smartcampus.tn>"
