# --- Claude (cle API : https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=anthropic:claude-sonnet-5-5
# Plusieurs modeles separes par des virgules = secours automatique en cas de surcharge/quota.
# Modele GRATUIT possible : Gemini (cle sur https://aistudio.google.com/apikey)
#   AGENT_MODEL=google:gemini-3.5-flash-lite (les Flash complets sont parfois surcharges ; les anciens modeles sont retires : lister ceux de votre cle dans AI Studio)
#   GOOGLE_API_KEY=

# --- user-service (meme valeurs que sa config JWT) ---
USER_SERVICE_URL=http://localhost:4001
JWT_ISSUER=smartcampus-user-service
JWT_AUDIENCE=smartcampus
# PRODUCTION : RS256, les cles publiques sont telechargees ici (aucun secret partage)
JWKS_URL=http://localhost:4001/.well-known/jwks.json
# DEVELOPPEMENT SEULEMENT (user-service sans cle RSA = HS256). Refuse si ENVIRONMENT=production.
JWT_SECRET=
ENVIRONMENT=development

# --- Limites ---
MAX_MESSAGE_CHARS=4000
# Vide = memoire en RAM (dev). Production : MongoDB
MONGO_URI=
CORS_ORIGINS=http://localhost:5173

# --- Limites de cout / securite ---
RATE_LIMIT_PER_MINUTE=20

# --- Voix (optionnel) : pip install coqui-tts  puis TTS_PROVIDER=coqui. VERIFIER la licence du modele (XTTS-v2 = non commercial) ---
# GRATUIT et leger : TTS_PROVIDER=piper (pip install piper-tts, puis python -m piper.download_voices --download-dir voices fr_FR-siwis-medium)
TTS_PROVIDER=none
PIPER_VOICE=voices/fr_FR-siwis-medium.onnx
TTS_MODEL=tts_models/fr/css10/vits
